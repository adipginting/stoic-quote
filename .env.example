# Environment variables for stoic-quote.
# Copy to .env and fill in. All keys are optional: features stay hidden until set.
# `.env` is gitignored; this example file is safe to commit. Never commit real keys.

# ---- API (apps/api) ----
PORT=3000
DATA_DIR=./data
SQLITE_PATH=./.data/stoic.db

# Enables DeepSeek quote explanations (feature hides without the key).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Enables Unsplash quote imagery (feature hides without the key).
UNSPLASH_ACCESS_KEY=

# ---- Web (apps/web) ----
API_URL=http://localhost:3000

# ---- Observability (optional, both apps) ----
# Traces + logs are disabled unless OTEL_EXPORTER_OTLP_ENDPOINT is set.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
# e.g. Authorization=Basic <base64(instanceId:token)>
OTEL_EXPORTER_OTLP_HEADERS=
